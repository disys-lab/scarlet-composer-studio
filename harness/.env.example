# ─── scarlet-agents — local docker-compose .env ────────────────────────────
# Copy this file to .env and fill in the values before running docker compose up.

# ─── Redis (Scarlets API backbone) ──────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_AUTH_TOKEN=your_redis_password_here

# ─── Scarlet image versions ──────────────────────────────────────────────────
SCARLET_VERSION=0.5.0

# ─── Campaign / bus configuration ───────────────────────────────────────────
# HEAD_BUS controls which global coordination bus workers subscribe to.
# Leave unset (default) for an isolated campaign (derived as {APP_ID}_headagent).
# Set explicitly only for a shared-head deployment:
#   HEAD_BUS=common_headagent
#
# HEAD_BUS=

# ─── LLM endpoint (deliberation, check-in, converse()) ──────────────────────
# Populate to enable AgentDialogue/deliberation - omitted entirely, the
# harness still runs (falls back to purely mechanical retry - see head.py).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Retry/timing knobs (optional - HarnessConfig defaults if unset) ───────
# TIMEOUT_SCAN_INTERVAL=0.5
# MAX_ATTEMPTS=2
# REPLY_SLACK=10.0
# MAX_CHECK_INS=2
# CHECK_IN_TIMEOUT=10.0
# CHECK_IN_MAX_TURNS=3
