# ─── Scarlet Composer Studio — notebooks .env ──────────────────────────────
# Copy this file to .env and fill in the values before running
# `docker compose up -d`.

# ─── Redis ──────────────────────────────────────────────────────────────────
# Self-hosted by this compose file - no external instance needed. This is
# the password it will be started with, so any value works as long as it's
# not empty. Published on host port 6380 to avoid colliding with a Redis
# you may already be running on the default 6379.
REDIS_AUTH_TOKEN=change_me_to_a_real_password

# ─── Notebook 06 only: the LLM behind the agent head ────────────────────────
# Any OpenAI-compatible endpoint. These are read by the jupyter service and
# passed through to the agent head when notebook 06 brings the fleet up -
# the head is the only container that ever sees them, and the notebook's own
# kernel never calls the LLM directly.
#
# Notebooks 01-05 don't use these at all; leave them blank if you're not
# running 06.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Notebook 06 only: agent identity (optional) ────────────────────────────
# An agent registers on the bus as "{APP_ID}_{NODE_ADDRESS}". These values
# name the containers the compose file starts AND what the notebook waits
# for, so they stay consistent by construction. The defaults below are what
# the notebook assumes - only change them if you're running more than one
# fleet against the same Redis.
#
# APP_ID=tutorial_stats
# HEAD_NODE_ADDRESS=head
# WORKER_NODE_ADDRESSES=worker1,worker2

# ─── Image versions (optional) ──────────────────────────────────────────────
# All default to :latest. Pin them to a released tag for a reproducible
# tutorial environment.
#
# AGENTS_VERSION=latest
# COMPOSER_VERSION=latest
# NOTEBOOKS_VERSION=latest
