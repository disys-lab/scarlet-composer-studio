# ─── Scarlet Composer Studio — LLM agent fleet tutorial .env ───────────────
# Copy this file to .env and fill in the values before running docker compose up.

# ─── Redis (self-hosted by this compose file, no external instance needed) ──
REDIS_AUTH_TOKEN=change_me_to_a_real_password

# ─── LLM credentials ─────────────────────────────────────────────────────────
# NOT set here - notebook 06 asks for LLM_BASE_URL/LLM_API_KEY/LLM_MODEL
# interactively, in the notebook itself, and passes them only to the head
# container it launches. Nothing to configure in this file for that part.
